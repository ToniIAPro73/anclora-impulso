# Database (REQUERIDO)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT
# Para generar secrets seguros en PowerShell:
#   [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="30d"

# Social login (opcional). Crear credenciales propias por entorno:
# Google -> https://console.cloud.google.com/apis/credentials
# GitHub -> https://github.com/settings/developers
# Callback debe registrarse EXACTO en el proveedor.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CALLBACK_URL="http://localhost:3001/api/auth/github/callback"

# Server
PORT=3001
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:3000,http://127.0.0.1:3000"

# Email notifications (opcional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
NOTIFICATION_DISPATCH_INTERVAL_MINUTES=15

# LLM - Groq (opcional, para generación de entrenamientos y nutrición con IA)
# Crea tu cuenta gratuita en https://console.groq.com → API Keys
LLM_PROVIDER="groq"
LLM_COACH_ENABLED=false
LLM_COACH_MAX_PROMPT_CHARS=6000
LLM_COACH_MAX_OUTPUT_TOKENS=450
LLM_COACH_MEMORY_MESSAGES=8
LLM_COACH_CACHE_TTL_SECONDS=300
LLM_COACH_WINDOW_MINUTES=60
LLM_COACH_WINDOW_LIMIT=20

# Health data import (web-only status/contract; disabled by default)
HEALTH_DATA_IMPORT_ENABLED=false

# Wearables / native app contracts (disabled by default; no external sync in CI)
WEARABLE_SYNC_ENABLED=false
WEARABLE_READINESS_ENABLED=false

# Premium differentiators (contracts only; disabled by default)
FORM_ANALYSIS_ENABLED=false
VOICE_COACH_ENABLED=false

GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_MODEL_PRIMARY="openai/gpt-oss-20b"
GROQ_MODEL_FALLBACK="llama-3.3-70b-versatile"
GROQ_MODEL_FAST="llama-3.1-8b-instant"
GROQ_MODEL_NO_EVIDENCE="llama-3.1-8b-instant"
GROQ_MODEL_GUARD="llama-3.1-8b-instant"

# Admin (opcional, lista separada por comas)
ADMIN_EMAILS=""

# OpenAI (deprecated - reemplazado por Groq)
# OPENAI_API_KEY=""
